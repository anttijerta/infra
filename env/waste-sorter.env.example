# Node
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
TZ=UTC

# App
LOG_LEVEL=info
# Generate with: openssl rand -base64 32
APP_KEY=
APP_URL=https://waste-sorter.jerta.fi

# Session
SESSION_DRIVER=cookie

# Models (optional)
MODEL_A=
MODEL_B=

# Usage caps
RATE_LIMIT_PER_IP_PER_MINUTE=5
RATE_LIMIT_PER_IP_DAILY=20
GLOBAL_MONTHLY_CAP_EUR=5
