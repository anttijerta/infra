# Node
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
TZ=UTC

# App
LOG_LEVEL=info
# Generate with: openssl rand -base64 32
APP_KEY=
APP_URL=https://waste-sorter.jerta.fi

# Session
SESSION_DRIVER=cookie

# Models (OpenAI). MODEL_A and MODEL_B default to the values shown.
# MODEL_A=gpt-6-luna
# MODEL_B=gpt-6.1-sol
# Required in production. Never commit a real key.
MODEL_API_KEY=
# true only for a keyless demo with simulated models.
ALLOW_MOCK_MODELS=false

# Usage caps
RATE_LIMIT_PER_IP_PER_MINUTE=5
RATE_LIMIT_PER_IP_DAILY=20
GLOBAL_MONTHLY_CAP_EUR=5
